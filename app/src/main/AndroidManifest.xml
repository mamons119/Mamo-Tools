<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Volume Boost -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Stable Cam -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Mamo Tools"
        android:allowBackup="false"
        android:largeHeap="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".VolumeBoostActivity"
            android:label="Volume Boost"
            android:exported="false" />

        <activity
            android:name=".StableCamActivity"
            android:label="Stable Cam"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ConverterActivity"
            android:label="PDF e Word"
            android:exported="false" />

        <activity
            android:name=".PdfToolsActivity"
            android:label="PDF Tools"
            android:exported="false" />

        <activity
            android:name=".PdfOrganizeActivity"
            android:label="PDF Tools"
            android:exported="false" />

        <activity
            android:name=".PdfImagesActivity"
            android:label="PDF Tools"
            android:exported="false" />

        <activity
            android:name=".AudioEditorActivity"
            android:label="Audio Editor"
            android:exported="false" />

        <activity
            android:name=".ImageConverterActivity"
            android:label="Image Converter"
            android:exported="false" />

        <activity
            android:name=".SystemMonitorActivity"
            android:label="System Monitor"
            android:exported="false" />

        <activity
            android:name=".VideoEditorActivity"
            android:label="Video Editor"
            android:exported="false" />

        <activity
            android:name=".PdfReaderActivity"
            android:label="Mamo Tools (PDF)"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-pdf" />
            </intent-filter>
        </activity>

        <provider
            android:name=".PdfShareProvider"
            android:authorities="it.mamotools.pdfshare"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".MonitorWidgetProvider"
            android:label="Mamo Tools · System Monitor"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_monitor_info" />
        </receiver>

        <receiver
            android:name=".BoostWidgetProvider"
            android:label="Mamo Tools · Volume Boost"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_boost_info" />
        </receiver>

        <service
            android:name=".MonitorWidgetViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".MonitorWidgetService"
            android:exported="false" />

        <service
            android:name=".BoostService"
            android:exported="false" />
    </application>
</manifest>
