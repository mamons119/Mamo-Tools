<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Volume Boost -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Stable Cam -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Telemetria -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Mamo Tools"
        android:allowBackup="false"
        android:largeHeap="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".VolumeBoostActivity"
            android:label="Volume Boost"
            android:exported="false" />

        <activity
            android:name=".StableCamActivity"
            android:label="Stable Cam"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".ConverterActivity"
            android:label="PDF e Word"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".FileToolsActivity"
            android:label="File Tools"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".PdfOrganizeActivity"
            android:label="PDF Tools"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".PdfImagesActivity"
            android:label="PDF Tools"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".MeasureToolsActivity"
            android:label="Strumenti di Misura"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".MixCalcActivity"
            android:label="Calcolo miscela"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".RulerActivity"
            android:label="Righello"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".LevelActivity"
            android:label="Livello"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".TelemetryActivity"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".PerfActivity"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".LeanActivity"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".RecorderActivity"
            android:label="Registra Onboard"
            android:launchMode="singleTop"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".SessionsActivity"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".SessionViewActivity"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".AudioEditorActivity"
            android:label="Mamo Tools (Audio Editor)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".ImageConverterActivity"
            android:label="Image Converter"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".SystemMonitorActivity"
            android:label="System Monitor"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".VideoEditorActivity"
            android:label="Mamo Tools (Video Editor)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mamovideo" />
                <data android:pathPattern=".*\\..*\\.mamovideo" />
                <data android:pathPattern=".*\\..*\\..*\\.mamovideo" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.mamovideo" />
                <data android:pathPattern=".*\\..*\\.mamovideo" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PdfReaderActivity"
            android:label="Mamo Tools (PDF)"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-pdf" />
            </intent-filter>
        </activity>

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".WordReaderActivity"
            android:label="Mamo Tools (Word)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>
        </activity>

        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode" android:name=".EpubReaderActivity"
            android:label="Mamo Tools (EPUB)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.epub" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CodeReaderActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:label="Mamo Tools (Codice)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-sh" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.java" />
                <data android:pathPattern=".*\\.kt" />
                <data android:pathPattern=".*\\.kts" />
                <data android:pathPattern=".*\\.c" />
                <data android:pathPattern=".*\\.h" />
                <data android:pathPattern=".*\\.cpp" />
                <data android:pathPattern=".*\\.cc" />
                <data android:pathPattern=".*\\.hpp" />
                <data android:pathPattern=".*\\.cs" />
                <data android:pathPattern=".*\\.js" />
                <data android:pathPattern=".*\\.mjs" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.tsx" />
                <data android:pathPattern=".*\\.jsx" />
                <data android:pathPattern=".*\\.py" />
                <data android:pathPattern=".*\\.go" />
                <data android:pathPattern=".*\\.rs" />
                <data android:pathPattern=".*\\.swift" />
                <data android:pathPattern=".*\\.php" />
                <data android:pathPattern=".*\\.rb" />
                <data android:pathPattern=".*\\.lua" />
                <data android:pathPattern=".*\\.dart" />
                <data android:pathPattern=".*\\.scala" />
                <data android:pathPattern=".*\\.gradle" />
                <data android:pathPattern=".*\\.sh" />
                <data android:pathPattern=".*\\.bash" />
                <data android:pathPattern=".*\\.zsh" />
                <data android:pathPattern=".*\\.ps1" />
                <data android:pathPattern=".*\\.bat" />
                <data android:pathPattern=".*\\.sql" />
                <data android:pathPattern=".*\\.xml" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.html" />
                <data android:pathPattern=".*\\.htm" />
                <data android:pathPattern=".*\\.css" />
                <data android:pathPattern=".*\\.scss" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\.toml" />
                <data android:pathPattern=".*\\.ini" />
                <data android:pathPattern=".*\\.properties" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\.kml" />
            </intent-filter>
        </activity>

        <activity
            android:name=".VideoProjectsActivity"
            android:label="Video Editor"
            android:exported="false" />

        <activity
            android:name=".AudioProjectsActivity"
            android:label="Audio Editor"
            android:exported="false" />

        <activity
            android:name=".ProducerActivity"
            android:label="Produzioni"
            android:exported="false" />

        <activity
            android:name=".ProdEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".SessionImportActivity"
            android:label="Mamo Tools (Telemetria)"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-mamotools-telemetry" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mamotel" />
                <data android:pathPattern=".*\\..*\\.mamotel" />
            </intent-filter>
        </activity>

        <provider
            android:name=".PdfShareProvider"
            android:authorities="it.mamotools.pdfshare"
            android:exported="false"
            android:grantUriPermissions="true" />


        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".BoostService"
            android:exported="false" />
    </application>
</manifest>
