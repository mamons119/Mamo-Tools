<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/boost_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/boost_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volume Boost"
                android:textColor="#ECEFF4"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/boost_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spento"
                android:textColor="#9AA3B2"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/boost_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingBottom="7dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="7dp"
            android:text="OFF"
            android:textColor="#ECEFF4"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/boost_gain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="+3.0 dB"
        android:textColor="#4DD0E1"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/boost_m5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="−5"
            android:textColor="#ECEFF4"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/boost_m1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="−1"
            android:textColor="#ECEFF4"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/boost_p1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="+1"
            android:textColor="#ECEFF4"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/boost_p5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="+5"
            android:textColor="#ECEFF4"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
